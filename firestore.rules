rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Get user's organization ID
    function getUserOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId;
    }

    // Helper: Check if user is in the same organization as the resource
    function isInSameOrg() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.organizationId == getUserOrgId();
    }

    // Helper: Check if user is a teacher, admin, or owner
    function isTeacherOrOwner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper: Check if user is an owner
    function isOwner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // Helper: Get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: Check if user is a student
    function isStudent() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    // Helper: Check if user is a parent
    function isParent() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    // Helper: Check if parent has approved link to a student
    function parentHasAccessToStudent(studentId) {
      return isParent() &&
        exists(/databases/$(database)/documents/parent_links/$(request.auth.uid + '_' + studentId)) &&
        get(/databases/$(database)/documents/parent_links/$(request.auth.uid + '_' + studentId)).data.status == 'approved';
    }

    // Helper: Check if user owns the resource
    function isResourceOwner() {
      return isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // Helper: Check if student is creating data for themselves
    function isCreatingOwnData() {
      return isAuth() && request.resource.data.studentId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // LOCKED — Internal Queues (no client access)
    // ═══════════════════════════════════════════════════════════════════════

    match /emailQueue/{queueId} {
      allow read, write: if false;
    }

    match /emailLogs/{logId} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // v1.6 Core Collections
    // ═══════════════════════════════════════════════════════════════════════

    // ====== Users Collection ======
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ====== Students (stored in users with role='student') ======
    // No separate students collection — students ARE users

    // ====== Classes Collection ======
    match /classes/{classId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Stages Collection ======
    match /stages/{stageId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Grades Collection ======
    match /grades/{gradeId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Groups Collection ======
    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Exams Collection ======
    match /exams/{examId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Questions Collection ======
    match /questions/{questionId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Question Bank Collection ======
    match /question_banks/{questionId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Submissions Collection ======
    match /submissions/{submissionId} {
      // Teachers/owners: full read; parents: read linked student's; students: read own
      allow read: if isTeacherOrOwner() ||
        (isParent() && resource.data.studentId != null &&
         parentHasAccessToStudent(resource.data.studentId)) ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      // Students can only create submissions for themselves
      allow create: if isTeacherOrOwner() || isCreatingOwnData();
      // Students can only update their own submissions
      allow update: if isTeacherOrOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if false;
    }

    // ====== Answers Collection ======
    match /answers/{answerId} {
      allow read: if isAuth();
      // Students can only create answers for their own submissions
      allow create: if isTeacherOrOwner() ||
        (isAuth() && request.resource.data.studentId == request.auth.uid);
      allow update: if isTeacherOrOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if false;
    }

    // ====== Exam Instances Collection ======
    match /exam_instances/{instanceId} {
      allow read: if isAuth();
      // Students can only create instances for themselves
      allow create: if isTeacherOrOwner() || isCreatingOwnData();
      // Students can only update their own instances
      allow update: if isTeacherOrOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if false;
    }

    // ====== Exam Stats Collection ======
    match /exam_stats/{statId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if false;
    }

    // ====== Violations Collection ======
    match /violations/{violationId} {
      allow read: if isAuth();
      // Students can only create violations for themselves
      allow create: if isTeacherOrOwner() || isCreatingOwnData();
      allow update: if isTeacherOrOwner();
      allow delete: if false;
    }

    // ====== Notifications Collection ======
    match /notifications/{notificationId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      // Users can only update their own notifications
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ====== Organizations Collection ======
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // Allow update if user is teacher/owner OR if they are the org owner (fixes chicken-egg during signup)
      allow update: if isTeacherOrOwner() || (isAuth() && resource.data.ownerId == request.auth.uid);
      allow delete: if false;
    }

    // ====== Invite Codes Collection ======
    match /invite_codes/{codeId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Subjects Collection ======
    match /subjects/{subjectId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Group Members Collection ======
    match /group_members/{memberId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Teacher Assignments Collection ======
    match /teacher_assignments/{assignmentId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Conversations Collection ======
    match /conversations/{conversationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // ====== Messages Collection ======
    match /messages/{messageId} {
      allow read: if isAuth() && isInSameOrg();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.senderId == request.auth.uid;
      allow delete: if false; // Messages are never truly deleted — use soft delete
    }

    // ====== Analytics Cache Collection ======
    match /analytics_cache/{cacheId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // v1.9 Enterprise Collections (Feature Flags, Permissions, Audit)
    // ═══════════════════════════════════════════════════════════════════════

    // ====== Feature Flags Collection ======
    match /feature_flags/{flagId} {
      allow read: if isAuth();
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // ====== Permission Overrides Collection ======
    match /permission_overrides/{overrideId} {
      allow read: if isAuth();
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // ====== Search Keywords Collection ======
    match /search_keywords/{keywordId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Deep Links Collection ======
    match /deep_links/{linkId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Campuses Collection ======
    match /campuses/{campusId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isOwner();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // v1.7 New Collections
    // ═══════════════════════════════════════════════════════════════════════

    // ====== Assignments Collection ======
    match /assignments/{assignmentId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Assignment Submissions Collection ======
    match /assignment_submissions/{submissionId} {
      allow read: if isAuth();
      // Students can only create their own submissions
      allow create: if isTeacherOrOwner() ||
        (isAuth() && request.resource.data.studentId == request.auth.uid);
      allow update: if isTeacherOrOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isTeacherOrOwner();
    }

    // ====== Attendance Collection ======
    match /attendance/{attendanceId} {
      // Teachers/owners: full access; Parents: read own linked student's records
      allow read: if isTeacherOrOwner() ||
        (isParent() && resource.data.studentId != null &&
         parentHasAccessToStudent(resource.data.studentId));
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Gradebook Collection ======
    match /gradebook/{gradebookId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Gradebook Categories Collection ======
    match /gradebook_categories/{categoryId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Gradebook Entries Collection ======
    match /gradebook_entries/{entryId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Parent Links Collection ======
    match /parent_links/{linkId} {
      // Anyone authenticated can read (for code lookup); only teachers create; parents update on link
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isAuth() &&
        (isTeacherOrOwner() ||
         (isParent() && resource.data.parentId == request.auth.uid));
      allow delete: if isTeacherOrOwner();
    }

    // ====== Exam Templates Collection ======
    match /exam_templates/{templateId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // v1.7 Feature-Complete Collections
    // ═══════════════════════════════════════════════════════════════════════

    // ====== Calendar Events Collection ======
    match /calendar_events/{eventId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Announcements Collection ======
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Academic Years Collection ======
    match /academic_years/{yearId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Audit Logs Collection ======
    match /audit_logs/{logId} {
      allow read: if isTeacherOrOwner();
      // Only teachers/owners can create audit logs
      allow create: if isTeacherOrOwner();
      allow update: if false;
      allow delete: if false;
    }

    // ====== Resources Collection ======
    match /resources/{resourceId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Materials Collection ======
    match /materials/{materialId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Lessons Collection ======
    match /lessons/{lessonId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Lesson Plans Collection ======
    match /lesson_plans/{planId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Progress Tracking Collection ======
    match /progress_tracking/{progressId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Moderation Queue Collection ======
    match /moderation_queue/{itemId} {
      allow read: if isTeacherOrOwner();
      allow create: if isAuth();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // v1.7 Ecosystem — Units & Content Progress
    // ═══════════════════════════════════════════════════════════════════════

    // ====== Units Collection ======
    match /units/{unitId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Content Progress Collection ======
    // Tracks student progress through LMS content (materials viewed, lessons completed)
    match /content_progress/{progressId} {
      allow read: if isAuth();
      // Students can only create their own progress records
      allow create: if isTeacherOrOwner() ||
        (isAuth() && request.resource.data.studentId == request.auth.uid);
      allow update: if isAuth();
      allow delete: if isTeacherOrOwner();
    }

    // ====== LiveKit Rooms Collection ======
    // Stores room metadata for virtual classrooms and proctored exams
    match /livekit_rooms/{roomId} {
      allow read: if isAuth() && isInSameOrg();
      // Only teachers can create rooms; students cannot start rooms
      allow create: if isTeacherOrOwner();
      // Only the room creator or another teacher can update (end, record, etc.)
      allow update: if isTeacherOrOwner();
      // Only owners can permanently delete room records
      allow delete: if isOwner();

      // ─── LiveKit Room Sub-Collections ───────────────────────

      // Attendance — students create/update own record on join/leave; teachers can update any
      match /attendance/{uid} {
        allow read: if isAuth();
        allow create: if isAuth() && request.auth.uid == uid;
        // Students can only update their own leftAt; teachers can update any
        allow update: if isAuth() &&
          (isTeacherOrOwner() ||
           (request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['leftAt', 'updatedAt'])));
        allow delete: if isTeacherOrOwner();
      }

      // Chat messages — anyone in org can send; only teachers can delete/moderate
      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
        // Only teachers can update (pin, edit); students cannot edit sent messages
        allow update: if isTeacherOrOwner();
        // Only teachers can delete messages (moderation)
        allow delete: if isTeacherOrOwner();
      }

      // Raised hands — students toggle own; teachers can lower any
      match /raised_hands/{uid} {
        allow read: if isAuth();
        allow create: if isAuth() && request.auth.uid == uid;
        allow update: if isAuth() && (isTeacherOrOwner() || request.auth.uid == uid);
        allow delete: if isTeacherOrOwner();
      }
    }

    // ====== Recordings Collection ======
    // Metadata for session recordings (playback URLs, storage refs)
    match /recordings/{recordingId} {
      allow read: if isAuth();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isOwner();
    }

    // ====== Scheduled Classes Collection ======
    // Upcoming live classes with start times and room references
    match /scheduled_classes/{classId} {
      allow read: if isAuth() && isInSameOrg();
      allow create: if isTeacherOrOwner();
      allow update: if isTeacherOrOwner();
      allow delete: if isTeacherOrOwner();
    }

    // ====== Session Analytics Collection ======
    // Post-class analytics: attendance, duration, engagement metrics
    match /session_analytics/{analyticsId} {
      allow read: if isAuth() && isInSameOrg();
      // Only Cloud Functions write analytics (clients cannot create/update)
      allow create: if false;
      allow update: if false;
      allow delete: if isOwner();
    }

  }
}
