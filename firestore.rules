rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Check if user is a teacher
    function isTeacher() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Helper: Get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ====== Users Collection ======
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ====== Students Collection ======
    match /students/{studentId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Classes Collection ======
    match /classes/{classId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Stages Collection ======
    match /stages/{stageId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Grades Collection ======
    match /grades/{gradeId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Groups Collection ======
    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Exams Collection ======
    match /exams/{examId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Questions Collection ======
    match /questions/{questionId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Question Bank Collection ======
    match /question_bank/{questionId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Submissions Collection ======
    match /submissions/{submissionId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // ====== Answers Collection ======
    match /answers/{answerId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // ====== Exam Instances Collection ======
    match /exam_instances/{instanceId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // ====== Exam Stats Collection ======
    match /exam_stats/{statId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if false;
    }

    // ====== Violations Collection ======
    match /violations/{violationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isTeacher();
      allow delete: if false;
    }

    // ====== Notifications Collection ======
    match /notifications/{notificationId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isAuth();
      allow delete: if false;
    }
  }
}
