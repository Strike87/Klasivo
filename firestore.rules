rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Check if user is a teacher
    function isTeacher() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Helper: Get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ====== Users Collection ======
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuth();
      // Only the user themselves can write their profile
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if false; // No deletion through client
    }

    // ====== Students Collection ======
    match /students/{studentId} {
      // Teachers can read/write all students
      // Students can read their own record
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Classes Collection ======
    match /classes/{classId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Exams Collection ======
    match /exams/{examId} {
      // Everyone authenticated can read exams
      // Only teachers can create/update/delete
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Questions Collection ======
    match /questions/{questionId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ====== Submissions Collection ======
    match /submissions/{submissionId} {
      // Teachers can read all, students can read their own
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false; // No deletion
    }

    // ====== Answers Collection ======
    match /answers/{answerId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false; // No deletion
    }
  }
}
