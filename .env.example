# ═══════════════════════════════════════════════════════════════
# Klasivo Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is already in .gitignore.
# ═══════════════════════════════════════════════════════════════

# Local database path (SQLite, used for offline caching)
DATABASE_URL=file:/path/to/your/local.db

# ─── Firebase ─────────────────────────────────────────────────
# These are auto-generated by `flutterfire configure` and stored
# in lib/firebase_options.dart. Only set these if you need to
# override the defaults at runtime.
#
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_STORAGE_BUCKET=

# ─── Email Service (Resend) ─────────────────────────────────
# API key for Resend transactional email service.
# Set via Firebase Secrets: firebase functions:secrets:set RESEND_API_KEY
# DO NOT put the actual key here — this file is version-controlled.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Feature Flags (optional) ────────────────────────────────
# Set to "true" to enable, "false" or unset to disable.
#
# ENABLE_OFFLINE_MODE=true
# ENABLE_ANALYTICS=false
# ENABLE_CRASHLYTICS=true
