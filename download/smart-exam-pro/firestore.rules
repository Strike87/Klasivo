rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(resource) {
      return request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    function isTeacher() {
      return request.auth != null;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // ===== CLASSES =====
    match /classes/{classId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isOwner(resource);
      allow delete: if isOwner(resource);
    }

    // ===== STUDENTS =====
    match /students/{studentId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ===== EXAMS =====
    match /exams/{examId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isOwner(resource);
      allow delete: if isOwner(resource);
    }

    // ===== QUESTIONS =====
    match /questions/{questionId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ===== SUBMISSIONS =====
    match /submissions/{submissionId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher();
    }

    // ===== ANSWERS =====
    match /answers/{answerId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===== VIOLATIONS =====
    match /violations/{violationId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ===== EXAM INSTANCES (Phase C) =====
    match /exam_instances/{instanceId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ===== QUESTION BANK (Phase C) =====
    match /question_bank/{questionId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ===== EXAM STATS (Phase C) =====
    match /exam_stats/{statsId} {
      allow read: if isTeacher();
      allow write: if isTeacher();
    }

    // ===== STAGES (Phase B) =====
    match /stages/{stageId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isOwner(resource);
      allow delete: if isOwner(resource);
    }

    // ===== GRADES (Phase B) =====
    match /grades/{gradeId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isOwner(resource);
      allow delete: if isOwner(resource);
    }

    // ===== GROUPS (Phase B) =====
    match /groups/{groupId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isOwner(resource);
      allow delete: if isOwner(resource);
    }
  }
}
